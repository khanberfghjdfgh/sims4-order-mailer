# Gmail credentials (use an App Password, NOT your real password)
GMAIL_ADDRESS=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Owner email for the daily summary (defaults to GMAIL_ADDRESS)
OWNER_EMAIL=your.email@gmail.com

# Dashboard access token - REQUIRED. Use a long random string.
ACCESS_TOKEN=use-a-long-random-string-here

# Cloud worker: NO web interface is exposed. Local PC: dashboard binds 127.0.0.1.
# On Koyeb set DISABLE_DASHBOARD=true.
DISABLE_DASHBOARD=false

# ALLOW_SEND: true on the cloud worker (it delivers emails).
# Set false on a local monitor copy so it never double-sends.
ALLOW_SEND=true

# Asset paths (override if not in default location)
# BANNER_PATH=./assets/email_banner.gif
# TORRENT_PATH=./assets/torrent.torrent
# TORRENT_FILENAME=The Sims 4 Ultimate Collection v1.125.59.1030.torrent

# Poll interval in milliseconds (default: 120000 = 2 minutes)
# POLL_INTERVAL_MS=120000

# Summary email interval in milliseconds (default: 43200000 = every 12h)
# SUMMARY_INTERVAL_MS=43200000

# Dashboard port (default: 3000)
# PORT=3000